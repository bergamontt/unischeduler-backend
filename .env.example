# Example of .env properties
POSTGRES_URL=jdbc:postgresql://unischeduler-db:5432/example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=example_db

# Microsoft Entra ID (OIDC)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# Frontend & Auth
FRONTEND_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=ukma.edu.ua

# Admin users (comma-separated corporate emails)
APP_ADMIN_EMAILS=admin@ukma.edu.ua

# Schedule importer (disabled by default)
UNISCHEDULER_IMPORT_ENABLED=false
UNISCHEDULER_IMPORT_TOKEN=
